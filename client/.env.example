# CampusConnect client (Vite). `VITE_API_URL` preferred; `REACT_APP_API_URL` also works.

# --- Local dev (default) ---
# Leave unset to use the Vite proxy in vite.config.js (/api → localhost:5000)

# --- Production ---
# Origin of your API (with or without trailing slash). /api is added if missing:
# VITE_API_URL=https://your-api.vercel.app
# or explicitly:
# VITE_API_URL=https://your-api.vercel.app/api

# On your *backend* .env / hosting dashboard set:
# CLIENT_URL=https://your-frontend.vercel.app
