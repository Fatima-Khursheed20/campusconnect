# CampusConnect client (Vite). Only vars prefixed with VITE_ are exposed to the app.
# Copy to .env and adjust:  cp .env.example .env
# https://vitejs.dev/guide/env-and-mode.html

# --- Local dev (default) ---
# Leave VITE_API_URL unset so src/services/api.js uses the Vite proxy: /api → localhost:5000
# (see vite.config.js). Uncomment below only if you want to hit the API URL directly:
# VITE_API_URL=http://localhost:5000/api

# --- Hosted frontend (Vercel, etc.) ---
# Set this in the host's dashboard or here for production builds:
# VITE_API_URL=https://your-api.example.com/api
